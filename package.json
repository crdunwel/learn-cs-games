{
  "name": "cs-arcade",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "format": "prettier --write src tests *.js *.json *.html README.md",
    "test:exam-c": "node scripts/native-exam-validation.mjs",
    "docs:check": "node scripts/context.mjs --check",
    "build:pages": "vite build --base=/learn-cs-games/",
    "test:release": "npm run build:pages && playwright test --config playwright.release.config.js"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "prettier": "^3.9.10",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=22.12.0 <23"
  }
}
